{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "title": "Welrok thermostat settings",
    "configFile": {
      "path": "/etc/wb-welrok.conf",
      "service": "wb-welrok",
      "toJSON": ["wb-welrok", "-j"],
      "validate": false
    },
    "definitions": {
        "device": {
            "type": "object",
            "title": "Device",
            "headerTemplate": "{{self.device_title}}",
            "properties": {
                "device_id": {
                    "type": "string",
                    "title": "WB MQTT id of the device",
                    "default": "",
                    "description": "device_id_description",
                    "propertyOrder": 1
                },
                "device_title": {
                    "type": "string",
                    "title": "Device name",
                    "default": "",
                    "description": "device_title_description",
                    "propertyOrder": 2
                },
                "device_ip": {
                    "type": "string",
                    "title": "Thermostat API IP address",
                    "default": "",
                    "description": "device_ip_description",
                    "propertyOrder": 3,
                    "format": "ipv4"
                },
                "inner_mqtt_client_id": {
                    "type": "string",
                    "title": "Internal mqtt client_id",
                    "default": "",
                    "description": "inner_mqtt_client_id_description",
                    "propertyOrder": 4
                },
                "inner_mqtt_pubprefix": {
                    "type": "string",
                    "title": "Internal mqtt pubprefix",
                    "default": "",
                    "description": "inner_mqtt_pubprefix_description",
                    "propertyOrder": 5
                },
                "inner_mqtt_subprefix": {
                    "type": "string",
                    "title": "Internal mqtt subprefix",
                    "default": "",
                    "description": "inner_mqtt_subprefix_description",
                    "propertyOrder": 6
                },
                "serial_number": {
                    "type": "string",
                    "title": "Thermostat serial number",
                    "default": "",
                    "description": "serial_number_description",
                    "propertyOrder": 7
                },
                "mqtt_enable": {
                    "type": "boolean",
                    "title": "Use MQTT",
                    "default": false,
                    "description": "mqtt_enable_description",
                    "propertyOrder": 8
                }
            },
            "required": [
              "device_id",
              "device_title",
              "device_ip",
              "inner_mqtt_client_id",
              "inner_mqtt_pubprefix",
              "inner_mqtt_subprefix",
              "serial_number",
              "mqtt_enable"
            ],
            "options": {
                "disable_edit_json": true,
                "disable_collapse": true,
                "disable_properties": true
            }
        }
    },
    "properties": {
        "devices": {
            "type": "array",
            "title": "Welrok Thermostat",
            "items": { "$ref": "#/definitions/device"},
            "options": {
                "array_controls_top": true,
                "disable_array_delete_last_row": true,
                "disable_array_reorder": true,
                "disable_collapse": true,
                "enable_array_copy": true,
                "disable_edit_json": true
            },
            "_format": "tabs",
            "propertyOrder": 1
        },
        "mqtt_server_uri": {
            "type": "string",
            "title": "MQTT broker URI",
            "default": "unix:///var/run/mosquitto/mosquitto.sock",
            "description": "mqtt_server_uri_description",
            "propertyOrder": 2
        },
        "debug": {
            "type": "boolean",
            "title": "Enable debug logging",
            "default": false,
            "_format": "checkbox",
            "propertyOrder": 3
        }
    },
    "required": [
        "devices",
        "debug"
    ],
    "options": {
        "disable_edit_json": true,
        "disable_collapse": true,
        "disable_properties": true
    },
    "translations": {
        "en": {
            "device_id_description": "The ID will be used to create a branch in Wiren Board MQTT /devices/{ID}/",
            "device_title_description": "Displayed device name in the Wiren Board panel",
            "device_ip_description": "IP address of Welrok thermostat",
            "inner_mqtt_client_id_description": "Id specified on the Welrok thermostat in the Client ID field",
            "inner_mqtt_pubprefix_description": "Topic specified on the Welrok thermostat in the Publish prefix field",
            "inner_mqtt_subprefix_description": "Topic specified on the Welrok thermostat in the Subscribe path field",
            "serial_number_description": "Required for local thermostat control",
            "mqtt_enable_description": "Use mqtt for control",
            "mqtt_server_uri_description": "The default connects to the local broker through its unix socket. To use a broker over TCP with a user and password: 'tcp://user:password@host:1883'"
        },
        "ru": {
            "Welrok Receivers": "Термостаты Welrok",
            "Device": "Устройство",
            "Welrok thermostat settings": "Настройка термостатов Welrok",
            "Enable debug logging": "Режим отладки",
            "WB MQTT id of the device": "Идентификатор устройства в MQTT WB",
            "Device name": "Название устройства",
            "Thermostat API IP address": "IP-адрес API термостата",
            "Internal mqtt client_id": "Внутренний mqtt client_id",
            "Internal mqtt pubprefix": "Внутренний префикс публикации mqtt",
            "Internal mqtt subprefix": "Внутренний префикс подписки mqtt",
            "Thermostat serial number": "Серийный номер термостата",
            "Names of thermostat data topics": "Названия топиков данных термостата",
            "Names of thermostat control topics": "Названия топиков управления термостатом",
            "Control via internal mqtt": "Управление через внутренний mqtt",
            "serial_number_description": "Необходим для локального управления термостатом",
            "device_id_description": "ID будет использован для создания ветки в Wiren Board MQTT /devices/{ID}/",
            "device_title_description": "Отображаемое название устройства в панели Wiren Board",
            "device_ip_description": "IP адрес терморегулятора Welrok",
            "inner_mqtt_client_id_description": "Id заданный на терморегуляторе Welrok в поле Client ID",
            "inner_mqtt_pubprefix_description": "Топик заданный на терморегуляторе Welrok в поле Publish prefix",
            "inner_mqtt_subprefix_description": "Топик заданный на терморегуляторе Welrok в поле Subscribe path",
            "mqtt_server_uri_description": "По умолчанию подключение к локальному брокеру через unix-сокет. Для подключения по TCP с пользователем и паролем: 'tcp://user:password@host:1883'",
            "mqtt_enable_description": "Использовать mqtt для управления"
        }
    }    
}
