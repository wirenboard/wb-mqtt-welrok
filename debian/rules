#!/usr/bin/make -f

export PYBUILD_NAME=wb-welrok
# pybuild runs the tests from a copy of the package in the build dir; the config tests validate
# against the schema shipped next to the sources
export PYBUILD_BEFORE_TEST=cp {dir}/wb-mqtt-welrok.schema.json {build_dir}/
export PYBUILD_AFTER_TEST=rm -f {build_dir}/wb-mqtt-welrok.schema.json
export PYBUILD_TEST_ARGS=-p no:cacheprovider

%:
	dh $@ --buildsystem=pybuild

override_dh_installsystemd:
	dh_installsystemd --name=wb-welrok

override_dh_genchanges:
	# Ensure generated .changes use a valid Changed-By value in CI builds
	# where the builder identity might be anonymized.
	# Extract Maintainer from debian/control, set DEB env vars, and run
	# dh_genchanges all in one shell so exports take effect.
	@set -e; \
	MAINT_LINE="$$(awk -F': ' '/^Maintainer:/ {print $$2; exit}' debian/control)"; \
	if [ -n "$$MAINT_LINE" ]; then \
		MAINT_EMAIL="$$(echo "$$MAINT_LINE" | sed -n 's/.*<\([^>]*\)>.*/\1/p')"; \
		MAINT_NAME="$$(echo "$$MAINT_LINE" | sed -n 's/\(.*\) <.*>/\1/p')"; \
		[ -n "$$MAINT_NAME" ] || MAINT_NAME="$$MAINT_LINE"; \
		[ -z "$$MAINT_EMAIL" ] || export DEBEMAIL="$$MAINT_EMAIL"; \
		export DEBFULLNAME="$$MAINT_NAME"; \
	fi; \
	dh_genchanges; \
	MAINT="$$(awk -F': ' '/^Maintainer:/ {print $$2; exit}' debian/control)"; \
	[ -n "$$MAINT" ] || MAINT="CI Builder <ci-builder@wirenboard.com>"; \
	for f in ../*.changes ../../*.changes *.changes; do \
		[ -f "$$f" ] || continue; \
		if grep -Eiq "(nobody|nowhere|no-?reply)" "$$f"; then \
			echo "Fixing Changed-By in $$f"; \
			sed -E -i "s|^Changed-By:.*$$|Changed-By: $$MAINT|g" "$$f"; \
		fi; \
	done; \
	echo "override_dh_genchanges done"
